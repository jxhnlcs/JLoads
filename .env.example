# Copie para .env e ajuste conforme necessário.
FRONTEND_PORT=8081
PUBLIC_ORIGIN=http://localhost:8081

YTDLP_VERSION=2026.08.19
YTDLP_JS_RUNTIME=deno

MAX_CONCURRENT_DOWNLOADS=3
MAX_QUEUE_SIZE=50
MAX_ACTIVE_JOBS_PER_CLIENT=5
MAX_BATCH_SIZE=5
MAX_FILE_SIZE=1GB
MAX_STORAGE_SIZE=10GB
MAX_MEDIA_DURATION=3h
DOWNLOAD_TIMEOUT=30m
DOWNLOAD_LIMIT_RATE=

CLEANUP_ENABLED=true
CLEANUP_MAX_AGE=30

RATE_LIMIT_ENABLED=true
RATE_LIMIT_API=120
RATE_LIMIT_ANALYZE=20
RATE_LIMIT_DOWNLOADS=10

BACKEND_CPUS=2
BACKEND_MEMORY=1536M
